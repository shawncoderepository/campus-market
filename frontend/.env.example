# ==============================================================================
# OrbAI Vue Template - 环境变量示例
# ==============================================================================
#
# 本文件只作为配置模板，不会被 Vite 自动加载。
# 拉取项目后请根据目标环境复制一份，再修改复制后的文件：
#
#   本地开发：cp .env.example .env.development
#   生产构建：cp .env.example .env.production
#
# `.env.development` 在执行 `npm run dev` 时加载；
# `.env.production` 在执行 `npm run build` 时加载。
# 修改环境文件后需要重启开发服务器或重新执行生产构建。
#
# 安全提醒：所有以 VITE_ 开头的变量都会进入浏览器代码，任何访问者均可
# 查看。严禁填写数据库密码、私钥、云平台密钥或其他服务端秘密。
#

# 应用名称
# 用于浏览器标题和页面品牌文案。
VITE_APP_TITLE=OrbAI Vue Template

# 后端接口基础地址
# 开发环境可使用 `/api`，并在 vite.config.ts 的 server.proxy 中配置代理；
# 生产环境也可使用网关反向代理路径，或填写完整 HTTPS 地址。
# 地址结尾不要添加 `/`，业务接口统一以 `/` 开头。
VITE_API_BASE_URL=/api

# 请求超时时间，单位为毫秒；10000 表示 10 秒。
VITE_API_TIMEOUT=10000

# 是否启用本地 Mock，可选值为 true / false。
# 开发环境可设为 true；生产环境必须修改为 false。
VITE_ENABLE_MOCK=true

# 应用部署基础路径
# 根目录部署填写 `/`；部署到子目录时必须以 `/` 开头和结尾，例如 `/admin/`。
# 此值同时用于 Vite 静态资源 base 和 Vue Router history base。
VITE_ROUTE_BASE=/
